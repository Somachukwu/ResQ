# ResQ Emergency Systems Intelligence — Environment Configuration
# Copy or edit .env in the project root with your actual keys.

# 1. Google Gemini 2.0 Flash AI Key (Multimodal Triage & Photo Computer Vision)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Optional: Override Gemini Model (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# 2. OpenWeatherMap API Key (Live Meteorological & Precipitation Feeds)
# Get a free key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# 3. OpenRouteService API Key (Road Driving Turn-by-Turn Routing & ETAs)
# Get a free key at: https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# 4. Flask Application Secret
SECRET_KEY=resq-emergency-intelligence-secret-key-2026
